// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Agente del equipo (gestoría). Todos los agentes ven todos los clientes.
model User {
  id           String         @id @default(cuid())
  nombre       String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  actividades  ActividadLog[]
  recibos      Recibo[]
  archivos     Archivo[]
}

// Catálogo de trámites. El honorario es solo referencia: cada Caso guarda el precio real cobrado.
model TramiteCatalogo {
  id            String  @id @default(cuid())
  nombre        String
  descripcion   String  @default("")
  badge         String  @default("")
  // Requisitos guardados como texto, un requisito por línea.
  requisitos    String  @default("")
  honorarioBase Int
  // Clave de la ilustración a mostrar en la tarjeta del sitio público.
  // Ver src/components/tramite-icons.tsx para las claves disponibles.
  icono         String  @default("documento")
  destacado     Boolean @default(false)
  activo        Boolean @default(true)
  orden         Int     @default(0)
  // Link de pago de Stripe (Payment Link) para este trámite, creado
  // manualmente en el dashboard de Stripe. Si está vacío, el pago en línea
  // no está disponible y se le pide al cliente escribir por WhatsApp.
  linkPago      String  @default("")
  casos         Caso[]
}

model Cliente {
  id         String       @id @default(cuid())
  nombre     String
  telefono   String
  email      String?
  createdAt  DateTime     @default(now())
  casos      Caso[]
  expedientes Expediente[]
}

// Agrupa varios Casos (trámites) del mismo contacto en un solo expediente
// familiar — ej. una persona que tramita su pasaporte y además el de su
// pareja e hijo. Todo Caso pertenece a exactamente un Expediente; los que
// no se agrupan explícitamente simplemente viven solos en el suyo.
model Expediente {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  createdAt DateTime @default(now())
  casos     Caso[]
}

// Un Caso es un trámite en curso para un cliente, y la tarjeta que se mueve en el kanban.
model Caso {
  id                  String           @id @default(cuid())
  clienteId           String
  cliente             Cliente          @relation(fields: [clienteId], references: [id])
  expedienteId        String
  expediente          Expediente       @relation(fields: [expedienteId], references: [id])
  // Nombre de para quién es este trámite específico, si es distinto del
  // contacto principal (ej. el cónyuge o un hijo). Si está vacío, el
  // trámite es para el propio contacto (caso.cliente).
  paraQuien           String?
  tramiteCatalogoId   String?
  tramiteCatalogo     TramiteCatalogo? @relation(fields: [tramiteCatalogoId], references: [id])
  etapa               String           @default("NUEVO_CONTACTO")
  precioCobrado       Int?
  motivoAjuste        String?
  documentosRecibidos Boolean          @default(false)
  pagado              Boolean          @default(false)
  fechaPago           DateTime?
  origen              String           @default("MANUAL")
  mensaje             String?
  // Pago en línea (Stripe Checkout). Nulos cuando el pago fue manual/WhatsApp.
  pagoPreferenciaId   String? // id de la Checkout Session de Stripe
  pagoId              String? // id del PaymentIntent de Stripe
  pagoMetodo          String? // "card" | "oxxo"
  // Token del link privado del "ticket virtual" del cliente (/mi-tramite/<token>).
  // Separado del id interno para poder regenerarlo si se filtra el link.
  tokenPublico        String           @unique @default(cuid())
  // Fecha en la que el caso llegó a la etapa ENTREGADO. Se usa para
  // archivarlo automáticamente 48 h después (ver src/lib/archivado.ts).
  // Se limpia si el caso se mueve de vuelta a otra etapa.
  entregadoEn         DateTime?
  // Si no es null, el caso está archivado: ya no aparece en el tablero pero
  // se conserva en la base de datos y se puede encontrar con el buscador.
  archivadoEn         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  actividades         ActividadLog[]
  recibos             Recibo[]
  citas               Cita[]
  archivos            Archivo[]
  formularios         FormularioDS160[]

  @@index([etapa])
  @@index([expedienteId])
  @@index([archivadoEn])
}

// Respuestas del cuestionario DS-160 que el cliente llena por su cuenta.
// Un caso puede tener varios (ej. una familia tramitando varias visas
// juntas: cada persona llena el suyo). Guardado como JSON libre (ver
// src/lib/ds160-campos.ts) porque no hay campos obligatorios.
model FormularioDS160 {
  id         String   @id @default(cuid())
  casoId     String
  caso       Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  // Link privado propio de este cuestionario (distinto del tokenPublico
  // del caso, para poder mandarle a cada persona el suyo).
  token      String   @unique @default(cuid())
  datosJson  String   @default("{}")
  enviado    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([casoId])
}

// Bitácora de actividad: visible para todo el equipo, no solo para quien la generó.
// visibleCliente marca cuáles de estas entradas también se muestran en el
// ticket virtual público del cliente (avances de su trámite).
model ActividadLog {
  id             String   @id @default(cuid())
  casoId         String
  caso           Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  userId         String?
  usuario        User?    @relation(fields: [userId], references: [id])
  tipo           String
  descripcion    String
  visibleCliente Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([casoId])
}

// Cita agendada para el trámite (ej. SRE, embajada, CBP). Visible para el cliente.
model Cita {
  id        String   @id @default(cuid())
  casoId    String
  caso      Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  fecha     DateTime
  lugar     String   @default("")
  nota      String   @default("")
  createdAt DateTime @default(now())

  @@index([casoId])
}

// Archivo subido por la gestoría para el cliente (formas, documentos, comprobantes).
model Archivo {
  id            String   @id @default(cuid())
  casoId        String
  caso          Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
  nombre        String
  rutaArchivo   String
  mimeType      String
  tamano        Int
  subidoPorId   String?
  subidoPor     User?    @relation(fields: [subidoPorId], references: [id])
  createdAt     DateTime @default(now())

  @@index([casoId])
}

// Recibo del honorario de gestoría cobrado (nunca incluye cuotas de gobierno).
model Recibo {
  id            String   @id @default(cuid())
  casoId        String
  caso          Caso     @relation(fields: [casoId], references: [id])
  folio         Int      @unique
  monto         Int
  motivoAjuste  String?
  generadoPorId String?
  generadoPor   User?    @relation(fields: [generadoPorId], references: [id])
  createdAt     DateTime @default(now())
}

// Errores del servidor capturados automáticamente (ver src/instrumentation.ts),
// para poder revisarlos desde el CRM sin necesitar acceso al servidor.
// Se conservan solo los últimos ~500 (ver src/lib/error-log.ts).
model ErrorLog {
  id        String   @id @default(cuid())
  mensaje   String
  stack     String?
  ruta      String?
  metodo    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
